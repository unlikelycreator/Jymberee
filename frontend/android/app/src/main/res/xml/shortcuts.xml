<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Basic: "Hey Google, open jymberee" -->
    <capability android:name="actions.intent.OPEN_APP">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="com.jymberee" />
    </capability>

    <!-- Fire SOS -->
    <capability android:name="custom.actions.intent.SOS_FIRE"
        app:queryPatterns="@array/sos_fire_queries">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.jymberee"
            android:targetClass="com.jymberee.MainActivity">
            <url-template android:value="sossafety://sos/fire" />
        </intent>
    </capability>

    <!-- Theft SOS -->
    <capability android:name="custom.actions.intent.SOS_THEFT"
        app:queryPatterns="@array/sos_theft_queries">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.jymberee"
            android:targetClass="com.jymberee.MainActivity">
            <url-template android:value="sossafety://sos/theft" />
        </intent>
    </capability>

    <!-- Rape SOS (sensitive word pe Google filter kar sakta hai, test carefully) -->
    <capability android:name="custom.actions.intent.SOS_RAPE"
        app:queryPatterns="@array/sos_rape_queries">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.jymberee"
            android:targetClass="com.jymberee.MainActivity">
            <url-template android:value="sossafety://sos/rape" />
        </intent>
    </capability>

    <!-- Medical SOS -->
    <capability android:name="custom.actions.intent.SOS_MEDICAL"
        app:queryPatterns="@array/sos_medical_queries">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.jymberee"
            android:targetClass="com.jymberee.MainActivity">
            <url-template android:value="sossafety://sos/medical" />
        </intent>
    </capability>

    <!-- Other SOS -->
    <capability android:name="custom.actions.intent.SOS_OTHER"
        app:queryPatterns="@array/sos_other_queries">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.jymberee"
            android:targetClass="com.jymberee.MainActivity">
            <url-template android:value="sossafety://sos/other" />
        </intent>
    </capability>
    </shortcuts>
